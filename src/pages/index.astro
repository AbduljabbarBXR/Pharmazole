---
import Base from '../layouts/Base.astro';
import { categories, site, categorySlug } from '../data/catalog.mjs';
const BASE = import.meta.env.BASE_URL;
const cats = categories();
const img = (name) => BASE + 'images/banners/' + name;
---

<Base>
  <section class="hero hero--plain" id="hero">
    <div class="hero-slide active"><img src={img('hero-banner-1.webp')} alt="" /></div>
    <div class="hero-slide"><img src={img('hero-banner-2.webp')} alt="" /></div>
    <div class="hero-slide"><img src={img('hero-banner-3.webp')} alt="" /></div>
    <div class="hero-slide"><img src={img('hero-banner-4.webp')} alt="" /></div>

    <button class="hero-arrow prev" id="hero-prev" aria-label="Previous slide">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
    </button>
    <button class="hero-arrow next" id="hero-next" aria-label="Next slide">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
    </button>
  </section>

  <section class="container">
    <div class="steps-band">
      <div class="step">
        <span class="step-n">1</span>
        <span class="step-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="9" cy="21" r="1.6" fill="currentColor" stroke="none"/><circle cx="19" cy="21" r="1.6" fill="currentColor" stroke="none"/><path d="M2 3h3l2.6 12.4a2 2 0 0 0 2 1.6h8.8a2 2 0 0 0 2-1.6L22 7H6"/></svg>
        </span>
        <span><b>Browse and add to cart</b><span class="muted" style="font-size:13px">Pick what you need from our catalog</span></span>
      </div>
      <div class="step-arrow" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </div>
      <div class="step">
        <span class="step-n">2</span>
        <span class="step-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="3"/><path d="M11 18h2"/></svg>
        </span>
        <span><b>Pay with Mpesa till</b><span class="muted" style="font-size:13px">Send the amount and confirm with your code</span></span>
      </div>
      <div class="step-arrow" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </div>
      <div class="step">
        <span class="step-n">3</span>
        <span class="step-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 17h16V8H8L4 17Z"/><circle cx="8" cy="20" r="1.8"/><circle cx="17" cy="20" r="1.8"/></svg>
        </span>
        <span><b>Delivered the same day</b><span class="muted" style="font-size:13px">Before 5PM, anywhere in Nairobi</span></span>
      </div>
    </div>

    <div class="trust-strip">
      <div class="trust-item">
        <span class="trust-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12.5 11 15.5 16.5 9"/></svg>
        </span>
        <span><b>Genuine medicines</b><span>From licensed distributors</span></span>
      </div>
      <div class="trust-item">
        <span class="trust-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2 4 5v6c0 5.05 3.4 9.8 8 11 4.6-1.2 8-5.95 8-11V5l-8-3Z"/></svg>
        </span>
        <span><b>PPB licensed</b><span>Pharmacist reviewed</span></span>
      </div>
      <div class="trust-item">
        <span class="trust-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z"/></svg>
        </span>
        <span><b>Same day delivery</b><span>Before 5PM across Nairobi</span></span>
      </div>
      <div class="trust-item">
        <span class="trust-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 4h16v12H7l-3 3V4Z"/><path d="M8 9h8M8 12h5"/></svg>
        </span>
        <span><b>Real human support</b><span>On WhatsApp, always</span></span>
      </div>
    </div>

    <h2 class="section-title" id="categories">Shop by category</h2>
    <div class="cat-cards">
      {cats.map((c) => (
        <a class="cat-card" href={BASE + 'category/' + categorySlug(c.name)}>
          <img src={BASE + 'images/categories/' + categorySlug(c.name) + '.webp'} alt={c.name} loading="lazy" onerror={`this.onerror=null;this.src='${BASE}images/fallback-product.png'`} />
          <div class="cat-card-body">
            <b>{c.name}</b>
            <span class="cat-card-count">{c.count} products</span>
            <span class="cat-card-cta">Browse
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="container">
    <div class="hero hero--inner" id="hero-promo">
      <div class="hero-slide active" style={`background-image:url('${img('hero-prices.webp')}')`}>
        <div class="hero-scrim" aria-hidden="true"></div>
        <div class="container hero-container">
          <div class="hero-copy">
            <span class="hero-eyebrow">Lowest everyday prices</span>
            <h1>{site.heroTitle}</h1>
            <p>{site.tagline} Pay with Mpesa till, then get it delivered to {site.delivery.zones[0].label} for KES {site.delivery.zones[0].fee}, or anywhere else in Nairobi for KES {site.delivery.zones[1].fee}.</p>
            <div class="hero-cta">
              <a class="btn hero-btn btn-lg" href="#categories">Browse products</a>
              <a class="btn btn-whatsapp btn-lg" href={'https://wa.me/' + site.whatsapp} target="_blank" rel="noopener">Order on WhatsApp</a>
            </div>
            <div class="hero-badges">
              <span class="hero-badge">Same day delivery</span>
              <span class="hero-badge">Genuine medicines</span>
              <span class="hero-badge">Mpesa till payment</span>
            </div>
          </div>
        </div>
      </div>

      <div class="hero-slide" style={`background-image:url('${img('hero-rx.webp')}')`}>
        <div class="hero-scrim" aria-hidden="true"></div>
        <div class="container hero-container">
          <div class="hero-copy">
            <span class="hero-eyebrow">Prescription medicines</span>
            <h1>Verified by a pharmacist, delivered to your door</h1>
            <p>Upload a photo of your prescription at checkout. Our pharmacist verifies it, then we pack and dispatch the same day.</p>
            <div class="hero-cta">
              <a class="btn hero-btn btn-lg" href={BASE + 'prescriptions'}>How it works</a>
              <a class="btn btn-outline btn-lg" href="#categories" style="background:transparent;color:#fff;border-color:rgba(255,255,255,.6)">Browse Rx medicines</a>
            </div>
            <div class="hero-badges">
              <span class="hero-badge">Pharmacist verified</span>
              <span class="hero-badge">Upload at checkout</span>
            </div>
          </div>
        </div>
      </div>

      <div class="hero-slide" style={`background-image:url('${img('hero-delivery.webp')}')`}>
        <div class="hero-scrim" aria-hidden="true"></div>
        <div class="container hero-container">
          <div class="hero-copy">
            <span class="hero-eyebrow">Same day delivery</span>
            <h1>Order before 5PM, get it today</h1>
            <p>Flat delivery fees: {site.delivery.zones[0].label} for KES {site.delivery.zones[0].fee}, rest of Nairobi for KES {site.delivery.zones[1].fee}. Your zone is remembered at checkout.</p>
            <div class="hero-cta">
              <a class="btn hero-btn btn-lg" href="#categories">Shop now</a>
              <a class="btn btn-outline btn-lg" href={BASE + 'delivery'} style="background:transparent;color:#fff;border-color:rgba(255,255,255,.6)">Delivery &amp; fees</a>
            </div>
            <div class="hero-badges">
              <span class="hero-badge">Orders before 5PM</span>
              <span class="hero-badge">Track your order</span>
            </div>
          </div>
        </div>
      </div>

      <button class="hero-arrow prev" id="hero-promo-prev" aria-label="Previous slide">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
      </button>
      <button class="hero-arrow next" id="hero-promo-next" aria-label="Next slide">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>

    <div class="feature-grid">
      <a class="feature-card" href={BASE + 'prescriptions'} style={`background-image:url('${img('feature-rx.webp')}')`}>
        <div class="feature-shade" aria-hidden="true"></div>
        <div class="feature-body">
          <span class="feature-tag">Prescription medicines</span>
          <h3>Verified by our pharmacist, delivered to your door</h3>
          <p>Products marked Prescription need a valid prescription. Upload a photo at checkout, our pharmacist verifies it, and we dispatch the same day.</p>
          <span class="feature-cta">How it works
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
          </span>
        </div>
      </a>
      <a class="feature-card" href={BASE + 'delivery'} style={`background-image:url('${img('feature-delivery.webp')}')`}>
        <div class="feature-shade" aria-hidden="true"></div>
        <div class="feature-body">
          <span class="feature-tag">Same day delivery</span>
          <h3>Order before 5PM, get it today</h3>
          <p>Flat delivery fees across Nairobi: {site.delivery.zones[0].label} for KES {site.delivery.zones[0].fee}, rest of Nairobi for KES {site.delivery.zones[1].fee}.</p>
          <span class="feature-cta">Delivery &amp; fees
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
          </span>
        </div>
      </a>
    </div>
  </section>

  <script>
    /* ---------- hero carousel ---------- */
    function initAutoplay(root, prevBtn, nextBtn) {
      const slides = Array.from(root.querySelectorAll('.hero-slide'));
      let cur = 0, timer = null;
      function go(i) {
        slides[cur].classList.remove('active');
        cur = (i + slides.length) % slides.length;
        slides[cur].classList.add('active');
        restart();
      }
      function restart() {
        clearInterval(timer);
        timer = setInterval(() => go(cur + 1), 6500);
      }
      if (prevBtn) prevBtn.addEventListener('click', () => go(cur - 1));
      if (nextBtn) nextBtn.addEventListener('click', () => go(cur + 1));
      root.addEventListener('mouseenter', () => clearInterval(timer));
      root.addEventListener('mouseleave', restart);
      restart();
    }
    initAutoplay(document.getElementById('hero'), document.getElementById('hero-prev'), document.getElementById('hero-next'));
    initAutoplay(document.getElementById('hero-promo'), document.getElementById('hero-promo-prev'), document.getElementById('hero-promo-next'));
  </script>
</Base>
