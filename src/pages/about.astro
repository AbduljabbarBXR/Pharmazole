---
import Base from '../layouts/Base.astro';
import { site } from '../data/catalog.mjs';
const BASE = import.meta.env.BASE_URL;
---

<Base title={`About ${site.brand}`} description="Pharmazole is a Nairobi pharmacy delivering genuine medicines at the lowest everyday prices with same-day delivery.">
  <div class="container" style="max-width:760px">
    <h1 class="page-head" style="font-size:28px">About {site.brand}</h1>
    <div class="panel" style="margin-bottom:16px">
      <p style="margin:0 0 12px"><b>{site.brand}</b> is a Nairobi-based pharmacy built around one idea: buying medicine online should be easy, honest and affordable.</p>
      <p style="margin:0 0 12px">We keep our everyday prices low — often lower than the big pharmacy chains — and deliver within hours across Nairobi. {site.delivery.zones[0].label} are our home turf, with a flat KES {site.delivery.zones[0].fee} delivery fee; the rest of Nairobi pays KES {site.delivery.zones[1].fee}.</p>
      <p style="margin:0">Every order is handled by a pharmacist, prescriptions are verified, and you can reach us directly on WhatsApp at any point.</p>
    </div>
    <div class="panel" style="margin-bottom:16px">
      <h3>Our promises</h3>
      <ul style="margin:0;padding-left:20px;display:grid;gap:8px">
        <li>Genuine medicines from licensed distributors</li>
        <li>Prices you can compare — set to be the lowest available</li>
        <li>Prescription medicines only against a valid prescription</li>
        <li>Same-day delivery for orders placed before 5PM</li>
        <li>A real pharmacist and a real human on WhatsApp</li>
      </ul>
    </div>
    <div class="panel">
      <h3>Licensing</h3>
      {site.legal.ppbLicense
        ? <p style="margin:0">Pharmacy and Poisons Board (Kenya) License No: <b>{site.legal.ppbLicense}</b>.{site.legal.pharmacist && <> Pharmacist in charge: <b>{site.legal.pharmacist}</b>.</>}</p>
        : <p style="margin:0">{site.legal.ppbDisclaimer}</p>}
      <p class="muted" style="margin:10px 0 0;font-size:13px">In line with the Kenya Data Protection Act 2019, your personal data and prescriptions are handled confidentially and never shared.</p>
    </div>
  </div>
</Base>
