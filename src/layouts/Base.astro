---
import { site, cartIndex, categorySlug as slug, categories } from '../data/catalog.mjs';
const BASE = import.meta.env.BASE_URL;
const cartIndexData = cartIndex();
const catList = categories();
const title = site.brand + ' | ' + site.tagline;
const desc = 'Order medicines online in Nairobi with fast delivery. Lowest everyday prices, Mpesa till payment, and genuine products from a PPB licensed pharmacy. South C, South B, Nairobi West KES 100 delivery; rest of Nairobi KES 300.';
const conditions = [
  ['Fever & Pain', 'Pain & Fever'],
  ['Cold & Flu', 'Cold & Flu'],
  ['Cough & Throat', 'Cough & Throat'],
  ['Allergies', 'Allergy'],
  ['Malaria', 'Malaria'],
  ['Diabetes', 'Diabetes'],
  ['High blood pressure', 'Hypertension'],
  ['Asthma', 'Asthma'],
  ['Arthritis & Joint pain', 'Arthritis'],
  ['Stomach upsets', 'Stomach & Digestion'],
  ['Heart health', 'Blood & Heart'],
  ['Bacterial infections', 'Antibiotics']
];
interface Props {
  title?: string;
  description?: string;
}
const { title: pageTitle = title, description = desc } = Astro.props;
const path = Astro.url.pathname;
const SITE = new URL(import.meta.env.SITE).origin;
const fullUrl = SITE + path;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={fullUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:image" content={SITE + BASE + 'images/og-card.png'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.brand} />
    <meta property="og:site_name" content={site.brand} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={BASE + 'favicon.svg'} />
    <link rel="stylesheet" href={BASE + 'styles/global.css'} />
    <link rel="manifest" href={BASE + 'manifest.webmanifest'} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Pharmacy',
      name: site.brand,
      description: site.tagline,
      url: fullUrl,
      logo: SITE + BASE + 'logo.png',
      priceRange: 'KES',
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: '+' + site.whatsapp,
        contactType: 'customer service'
      },
      areaServed: 'Nairobi, Kenya'
    })} />
  </head>
  <body>
    <script type="application/json" id="pz-site" set:html={JSON.stringify(site)}></script>
    <script type="application/json" id="pz-catalog" set:html={JSON.stringify(cartIndexData)}></script>
    <script type="application/json" id="pz-base" set:html={JSON.stringify(BASE)}></script>
    <script src={BASE + 'scripts/store.js'}></script>

    <header class="site-header">
      <div class="header-inner container">
        <a class="logo" href={BASE}>
          <img src={BASE + 'images/Logo/logo.png'} alt="" />
          <span class="logo-name">Pharma<span>zole</span></span>
        </a>
        <button class="menu-btn" id="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="main-nav">
          <svg class="ico-burger" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          <svg class="ico-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
        <nav class="main-nav" id="main-nav" aria-label="Main navigation">
          <div class="nav-dd" id="nav-dd-cond">
            <button class="nav-dd-toggle" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="nav-dd-cond-menu">
              Shop by condition
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="nav-dd-menu" id="nav-dd-cond-menu">
              {conditions.map(([label, cat]) => (
                <a href={BASE + 'category/' + slug(cat)}>
                  <span>{label}</span>
                  <span class="nav-dd-count">{catList.find((c) => c.name === cat)?.count || 0}</span>
                </a>
              ))}
            </div>
          </div>
          <div class="nav-dd" id="nav-dd">
            <button class="nav-dd-toggle" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="nav-dd-menu">
              Shop by category
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="nav-dd-menu" id="nav-dd-menu">
              {catList.map((c) => (
                <a href={BASE + 'category/' + slug(c.name)}>
                  <span>{c.name}</span>
                  <span class="nav-dd-count">{c.count}</span>
                </a>
              ))}
            </div>
          </div>
          <a href={BASE + 'category/' + slug('Supplements')}>Supplements</a>
          <a href={BASE + 'prescriptions'}>Rx medicines</a>
          <a href={BASE + 'delivery'}>Delivery</a>
          <a href={BASE + 'about'}>About</a>
        </nav>
        <form class="header-search" action={BASE + 'search'} method="get" role="search">
          <span class="search-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          </span>
          <input type="search" name="q" placeholder="Search medicines, vitamins, care products…" aria-label="Search products" autocomplete="off" />
        </form>
        <div class="header-actions">
          <label class="zone-pill" title="Choose your delivery area">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 1 1 14 0c0 5.5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
            <select id="zone-select" aria-label="Choose delivery area">
              {site.delivery.zones.map((z) => (
                <option value={z.id}>{z.id === 'south' ? 'South C area' : 'Nairobi'}</option>
              ))}
            </select>
          </label>
          <a class="icon-btn" href={'https://wa.me/' + site.whatsapp} target="_blank" rel="noopener" title="Chat on WhatsApp" aria-label="Chat on WhatsApp">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.5 14.9L2 22l5.25-1.5A9.9 9.9 0 1 0 12.04 2Zm5.8 14.06c-.24.68-1.4 1.3-1.93 1.35-.52.05-1.17.24-3.95-.82-3.34-1.3-5.44-4.66-5.6-4.88-.16-.22-1.34-1.79-1.34-3.41 0-1.63.85-2.43 1.15-2.76.3-.33.66-.41.88-.41h.63c.2 0 .48-.08.75.57.27.66.93 2.28 1.01 2.45.08.16.14.36.03.58-.11.22-.17.35-.33.54-.16.19-.35.43-.5.57-.16.16-.33.34-.14.66.19.33.85 1.4 1.82 2.27 1.25 1.12 2.3 1.47 2.63 1.63.33.16.52.14.71-.08.19-.22.82-.95 1.04-1.28.22-.33.44-.27.74-.16.3.11 1.9.9 2.23 1.06.33.16.54.24.62.38.08.13.08.79-.16 1.47Z"/></svg>
          </a>
          <button class="icon-btn" id="cart-open" onclick="PZ_openCart()" aria-label="Open cart" title="Cart">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="9" cy="21" r="1.6" fill="currentColor" stroke="none"/>
              <circle cx="19" cy="21" r="1.6" fill="currentColor" stroke="none"/>
              <path d="M2 3h3l2.6 12.4a2 2 0 0 0 2 1.6h8.8a2 2 0 0 0 2-1.6L22 7H6"/>
            </svg>
            <span class="cart-count hide" id="cart-count">0</span>
          </button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <h4>{site.brand}</h4>
          <p style="margin:0 0 10px">{site.tagline} Genuine medicines, lowest everyday prices, and same day delivery across Nairobi.</p>
          <p style="margin:0">WhatsApp: {site.whatsappDisplay}</p>
        </div>
        <div>
          <h4>Shop</h4>
          <p style="margin:0 0 8px"><a href={BASE + 'search'}>Search all products</a></p>
          <p style="margin:0 0 8px"><a href={BASE + 'category/' + slug('Pain & Fever')}>Pain &amp; Fever</a></p>
          <p style="margin:0 0 8px"><a href={BASE + 'category/' + slug('Cold & Flu')}>Cold &amp; Flu</a></p>
          <p style="margin:0 0 8px"><a href={BASE + 'category/' + slug('Cough & Throat')}>Cough &amp; Throat</a></p>
          <p style="margin:0 0 8px"><a href={BASE + 'category/' + slug('Diabetes')}>Diabetes</a></p>
          <p style="margin:0 0 8px"><a href={BASE + 'category/' + slug('Antibiotics')}>Antibiotics</a></p>
        </div>
        <div>
          <h4>Support</h4>
          <p style="margin:0 0 8px"><a href={'https://wa.me/' + site.whatsapp} target="_blank" rel="noopener">Chat with us on WhatsApp</a></p>
          <p style="margin:0 0 8px"><a href={BASE + 'delivery'}>Delivery &amp; fees</a></p>
          <p style="margin:0 0 8px"><a href={BASE + 'prescriptions'}>Prescription medicines</a></p>
          <p style="margin:0 0 8px"><a href={BASE + 'about'}>About {site.brand}</a></p>
          <p style="margin:0 0 8px"><a href={BASE + 'privacy'}>Privacy</a></p>
          <p style="margin:0"><a href={BASE + 'terms'}>Terms</a></p>
        </div>
        <div>
          <h4>Contact</h4>
          <p style="margin:0 0 8px"><b style="color:#fff">WhatsApp:</b> {site.whatsappDisplay}</p>
          <p style="margin:0 0 8px"><b style="color:#fff">Hours:</b> Mon to Sat, 8am to 7pm</p>
          <p style="margin:0"><b style="color:#fff">Pay:</b> Mpesa till {site.tillNumber} ({site.tillName})</p>
        </div>
      </div>
      <div class="container footer-legal">
        {site.legal.ppbDisclaimer}
        {site.legal.ppbLicense && <span> &middot; PPB License No: {site.legal.ppbLicense}</span>}
        {site.legal.pharmacist && <span> &middot; Pharmacist in charge: {site.legal.pharmacist}</span>}
        <div style="margin-top:8px">&copy; {new Date().getFullYear()} {site.brand}. All rights reserved.</div>
      </div>
    </footer>

    <a class="wa-float" href={'https://wa.me/' + site.whatsapp} target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.5 14.9L2 22l5.25-1.5A9.9 9.9 0 1 0 12.04 2Zm5.8 14.06c-.24.68-1.4 1.3-1.93 1.35-.52.05-1.17.24-3.95-.82-3.34-1.3-5.44-4.66-5.6-4.88-.16-.22-1.34-1.79-1.34-3.41 0-1.63.85-2.43 1.15-2.76.3-.33.66-.41.88-.41h.63c.2 0 .48-.08.75.57.27.66.93 2.28 1.01 2.45.08.16.14.36.03.58-.11.22-.17.35-.33.54-.16.19-.35.43-.5.57-.16.16-.33.34-.14.66.19.33.85 1.4 1.82 2.27 1.25 1.12 2.3 1.47 2.63 1.63.33.16.52.14.71-.08.19-.22.82-.95 1.04-1.28.22-.33.44-.27.74-.16.3.11 1.9.9 2.23 1.06.33.16.54.24.62.38.08.13.08.79-.16 1.47Z"/></svg>
    </a>

    <div class="drawer-overlay" id="drawer-overlay"></div>
    <aside class="drawer" id="cart-drawer" aria-label="Cart">
      <div class="drawer-head">
        <h3>Your cart</h3>
        <button class="icon-btn" onclick="PZ_closeCart()" aria-label="Close cart">&times;</button>
      </div>
      <div class="drawer-body" id="drawer-list"></div>
      <div class="drawer-foot">
        <div id="drawer-subtotal"></div>
        <a class="btn btn-lg" id="drawer-checkout" href={BASE + 'checkout'}>Checkout</a>
      </div>
    </aside>

    <script>
      (function () {
        function setupDropdown(dd) {
          const toggle = dd && dd.querySelector('.nav-dd-toggle');
          if (!dd || !toggle) return;
          toggle.addEventListener('click', (e) => {
            e.stopPropagation();
            const open = dd.classList.toggle('open');
            toggle.setAttribute('aria-expanded', String(open));
          });
          document.addEventListener('click', (e) => {
            if (!dd.contains(e.target)) {
              dd.classList.remove('open');
              toggle.setAttribute('aria-expanded', 'false');
            }
          });
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
              dd.classList.remove('open');
              toggle.setAttribute('aria-expanded', 'false');
              toggle.focus();
            }
          });
        }
        setupDropdown(document.getElementById('nav-dd'));
        setupDropdown(document.getElementById('nav-dd-cond'));

        const menuBtn = document.getElementById('menu-btn');
        const nav = document.getElementById('main-nav');
        if (menuBtn && nav) {
          menuBtn.addEventListener('click', () => {
            const open = nav.classList.toggle('open');
            menuBtn.classList.toggle('open', open);
            menuBtn.setAttribute('aria-expanded', String(open));
          });
          nav.addEventListener('click', (e) => {
            if (e.target.closest('a')) {
              nav.classList.remove('open');
              menuBtn.classList.remove('open');
              menuBtn.setAttribute('aria-expanded', 'false');
            }
          });
        }

        const sel = document.getElementById('zone-select');
        if (!sel) return;
        const cur = PZ.zone();
        if (cur) sel.value = cur.id;
        sel.addEventListener('change', () => {
          const z = (PZ.SITE.delivery.zones || []).find((x) => x.id === sel.value);
          if (z) {
            PZ.saveZone({ id: z.id, fee: z.fee });
            PZ.toast('Delivery area set to ' + z.label);
          }
        });
      })();
    </script>
  </body>
</html>
